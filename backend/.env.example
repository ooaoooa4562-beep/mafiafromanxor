# Copy values into your shell or deployment environment. Never commit real secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Tashkent
# Set REDIS_URL and install channels-redis for production/multi-worker Channels.
# REDIS_URL=redis://127.0.0.1:6379/0

# Game phase timers in seconds
GAME_NIGHT_SECONDS=30
GAME_DAY_SECONDS=60
